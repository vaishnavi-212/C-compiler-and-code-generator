%{
/* ============================================================================
 * parser.y  -  PHASE 2: SYNTAX ANALYSIS  (Yacc / Bison grammar)
 * ----------------------------------------------------------------------------
 * The GRAMMAR of our C subset is written here directly as productions.
 * Bison turns it into an LALR(1) parse table (shift / reduce / goto) and a
 * bottom-up parser in parser.cpp.  The semantic action attached to each
 * production builds one AST node every time that production is REDUCED.
 *
 * The grammar is unambiguous by construction:
 *   - precedence and associativity come from the layered expression rules
 *     (expr > or_expr > and_expr > eq_expr > rel_expr > add_expr > term > factor)
 *   - the dangling else is settled with %nonassoc LOWER_THAN_ELSE / ELSE
 * so Bison reports 0 conflicts (see parser.output, generated by bison -v).
 *
 * Error recovery: the 'error' token gives panic-mode recovery - after a
 * syntax error the parser discards tokens up to the next ';' and continues,
 * so several syntax errors can be reported in one run.
 * ========================================================================== */
#include <cstdarg>
#include <cstdio>
#include <string>
#include "ast.h"
#include "front.h"

/* Capture Bison's debug trace (states, shifts, reductions) into a string so
   the front end can replay the LR parse step by step. */
int traceFprintf(FILE*, const char* fmt, ...);
#define YYFPRINTF traceFprintf

void yyerror(const char* msg);

static Node* N(const char* kind, const std::string& text, int line, int col) {
    return g_arena.make(kind, text, line, col);
}
%}

%define api.value.type {Node*}
%define parse.error verbose
%define parse.trace
%locations

%token INT FLOAT CHAR VOID IF ELSE WHILE FOR RETURN BREAK CONTINUE
%token ID INTLIT FLOATLIT CHARLIT STRLIT
%token INC DEC EQ NE LE GE AND OR

/* Operator precedence is written INTO the grammar (one non-terminal per
   level, see expr ... factor below). Only the dangling else needs a
   declaration: an ELSE binds to the nearest IF (shift preferred). */
%nonassoc LOWER_THAN_ELSE
%nonassoc ELSE

%start program

%%

program
    : ext_list                          { g_root = $1; }
    ;

ext_list
    : %empty                            { $$ = N("Program", "", 1, 1); g_root = $$; }
    | ext_list ext                      { $$ = $1; $$->add($2); g_root = $$; }
    ;

ext
    : func_def                          { $$ = $1; }
    | func_proto ';'                    { $$ = $1; }
    | var_decl ';'                      { $$ = $1; $$->text = "global"; }
    | error ';'                         { $$ = nullptr; yyerrok; }
    | error '}'                         { $$ = nullptr; yyerrok; }
    ;

type_spec
    : INT                               { $$ = N("Type", "int", @1.first_line, @1.first_column); }
    | FLOAT                             { $$ = N("Type", "float", @1.first_line, @1.first_column); }
    | CHAR                              { $$ = N("Type", "char", @1.first_line, @1.first_column); }
    | VOID                              { $$ = N("Type", "void", @1.first_line, @1.first_column); }
    ;

func_def
    : type_spec ID '(' params ')' block { $$ = N("FuncDef", $2->text, @2.first_line, @2.first_column); $$->add($1)->add($4)->add($6); }
    ;

func_proto
    : type_spec ID '(' params ')'       { $$ = N("FuncProto", $2->text, @2.first_line, @2.first_column); $$->add($1)->add($4); }
    ;

params
    : %empty                            { $$ = N("Params", "", 0, 0); }
    | VOID                              { $$ = N("Params", "", 0, 0); }
    | param_list                        { $$ = $1; }
    ;

param_list
    : param                             { $$ = N("Params", "", 0, 0); $$->add($1); }
    | param_list ',' param              { $$ = $1; $$->add($3); }
    ;

param
    : type_spec ID                      { $$ = N("Param", $2->text, @2.first_line, @2.first_column); $$->add($1); }
    ;

block
    : '{' stmt_list '}'                 { $$ = $2; $$->line = @1.first_line; $$->col = @1.first_column; }
    ;

stmt_list
    : %empty                            { $$ = N("Block", "", 0, 0); }
    | stmt_list stmt                    { $$ = $1; $$->add($2); }
    ;

stmt
    : var_decl ';'                      { $$ = $1; }
    | expr ';'                          { $$ = N("ExprStmt", "", @1.first_line, @1.first_column); $$->add($1); }
    | ';'                               { $$ = N("Empty", "", @1.first_line, @1.first_column); }
    | block                             { $$ = $1; }
    | IF '(' expr ')' stmt %prec LOWER_THAN_ELSE
                                        { $$ = N("If", "", @1.first_line, @1.first_column); $$->add($3)->add($5); }
    | IF '(' expr ')' stmt ELSE stmt    { $$ = N("If", "else", @1.first_line, @1.first_column); $$->add($3)->add($5)->add($7); }
    | WHILE '(' expr ')' stmt           { $$ = N("While", "", @1.first_line, @1.first_column); $$->add($3)->add($5); }
    | FOR '(' for_init ';' opt_expr ';' opt_expr ')' stmt
                                        { $$ = N("For", "", @1.first_line, @1.first_column); $$->add($3)->add($5)->add($7)->add($9); }
    | RETURN opt_expr ';'               { $$ = N("Return", "", @1.first_line, @1.first_column); $$->add($2); }
    | BREAK ';'                         { $$ = N("Break", "", @1.first_line, @1.first_column); }
    | CONTINUE ';'                      { $$ = N("Continue", "", @1.first_line, @1.first_column); }
    | error ';'                         { $$ = N("Empty", "", @1.first_line, @1.first_column); yyerrok; }
    ;

for_init
    : %empty                            { $$ = N("Empty", "", 0, 0); }
    | var_decl                          { $$ = $1; }
    | expr                              { $$ = N("ExprStmt", "", @1.first_line, @1.first_column); $$->add($1); }
    ;

opt_expr
    : %empty                            { $$ = N("Empty", "", 0, 0); }
    | expr                              { $$ = $1; }
    ;

var_decl
    : type_spec init_list               { $$ = $2; $$->add($1); $$->line = @1.first_line; $$->col = @1.first_column; }
    ;

init_list
    : init                              { $$ = N("VarDecl", "", 0, 0); $$->add($1); }
    | init_list ',' init                { $$ = $1; $$->add($3); }
    ;

init
    : ID                                { $$ = N("Var", $1->text, @1.first_line, @1.first_column); }
    | ID '=' expr                       { $$ = N("Var", $1->text, @1.first_line, @1.first_column); $$->add($3); }
    ;

/* ---------------------------------------------------------------------------
 * EXPRESSIONS - the textbook layered grammar (E -> E + T | T, T -> T * F | F).
 * One non-terminal per precedence level: the lower in the list, the tighter it
 * binds. Left recursion (add_expr : add_expr '+' term) gives LEFT associativity
 * and is exactly what an LR parser handles naturally.
 * ------------------------------------------------------------------------- */
expr
    : ID '=' expr                       { $$ = N("Assign", $1->text, @1.first_line, @1.first_column); $$->add($3); }
    | or_expr                           { $$ = $1; }
    ;

or_expr
    : or_expr OR and_expr               { $$ = N("Binary", "||", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | and_expr                          { $$ = $1; }
    ;

and_expr
    : and_expr AND eq_expr              { $$ = N("Binary", "&&", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | eq_expr                           { $$ = $1; }
    ;

eq_expr
    : eq_expr EQ rel_expr               { $$ = N("Binary", "==", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | eq_expr NE rel_expr               { $$ = N("Binary", "!=", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | rel_expr                          { $$ = $1; }
    ;

rel_expr
    : rel_expr '<' add_expr             { $$ = N("Binary", "<", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | rel_expr '>' add_expr             { $$ = N("Binary", ">", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | rel_expr LE add_expr              { $$ = N("Binary", "<=", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | rel_expr GE add_expr              { $$ = N("Binary", ">=", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | add_expr                          { $$ = $1; }
    ;

add_expr
    : add_expr '+' term                 { $$ = N("Binary", "+", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | add_expr '-' term                 { $$ = N("Binary", "-", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | term                              { $$ = $1; }
    ;

term
    : term '*' factor                   { $$ = N("Binary", "*", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | term '/' factor                   { $$ = N("Binary", "/", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | term '%' factor                   { $$ = N("Binary", "%", @2.first_line, @2.first_column); $$->add($1)->add($3); }
    | factor                            { $$ = $1; }
    ;

factor
    : '-' factor                        { $$ = N("Unary", "-", @1.first_line, @1.first_column); $$->add($2); }
    | '!' factor                        { $$ = N("Unary", "!", @1.first_line, @1.first_column); $$->add($2); }
    | INC ID                            { $$ = N("IncDec", "++x", @1.first_line, @1.first_column); $$->add(N("Ident", $2->text, @2.first_line, @2.first_column)); }
    | DEC ID                            { $$ = N("IncDec", "--x", @1.first_line, @1.first_column); $$->add(N("Ident", $2->text, @2.first_line, @2.first_column)); }
    | ID INC                            { $$ = N("IncDec", "x++", @1.first_line, @1.first_column); $$->add(N("Ident", $1->text, @1.first_line, @1.first_column)); }
    | ID DEC                            { $$ = N("IncDec", "x--", @1.first_line, @1.first_column); $$->add(N("Ident", $1->text, @1.first_line, @1.first_column)); }
    | '(' expr ')'                      { $$ = $2; }
    | ID                                { $$ = N("Ident", $1->text, @1.first_line, @1.first_column); }
    | ID '(' args ')'                   { $$ = N("Call", $1->text, @1.first_line, @1.first_column); $$->add($3); }
    | INTLIT                            { $$ = N("IntLit", $1->text, @1.first_line, @1.first_column); }
    | FLOATLIT                          { $$ = N("FloatLit", $1->text, @1.first_line, @1.first_column); }
    | CHARLIT                           { $$ = N("CharLit", $1->text, @1.first_line, @1.first_column); }
    | STRLIT                            { $$ = N("StrLit", $1->text, @1.first_line, @1.first_column); }
    ;

args
    : %empty                            { $$ = N("Args", "", 0, 0); }
    | arg_list                          { $$ = $1; }
    ;

arg_list
    : expr                              { $$ = N("Args", "", 0, 0); $$->add($1); }
    | arg_list ',' expr                 { $$ = $1; $$->add($3); }
    ;

%%

thread_local std::string g_parseTrace;

int traceFprintf(FILE*, const char* fmt, ...) {
    char buf[1024];
    va_list ap;
    va_start(ap, fmt);
    int n = vsnprintf(buf, sizeof buf, fmt, ap);
    va_end(ap);
    if (g_parseTrace.size() < 4000000) g_parseTrace += buf;
    return n;
}

void yyerror(const char* msg) {
    std::string m = msg;
    // Bison says "syntax error, unexpected X, expecting Y" - make token names friendlier
    g_diags.push_back({"syntax", "error", yylloc.first_line, yylloc.first_column, m});
}
